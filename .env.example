# Smart Attendance - copy to .env and edit. Never commit .env.

# --- MySQL (required) -------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smart_attendance
MYSQL_USER=attendance
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=20

# --- Administrator login for the web UI (required) ---------------------------
# The UI refuses to sign anyone in while this is empty or a placeholder.
ADMIN_ID=ADMIN
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Secret used to sign login tokens. Set a long random value (python -c "import secrets;print(secrets.token_hex(32))").
# If empty a random one is generated at start-up, which signs everyone out on every restart.
APP_SECRET_KEY=

# --- Web server ---------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated browser origins allowed to call the API from another site. Leave empty (same-origin only).
CORS_ORIGINS=

# --- Time zone (IMPORTANT) ------------------------------------------------------
# Timetable times are wall-clock times in this zone, e.g. Asia/Kolkata, Europe/London, America/New_York.
# If empty the server computer's zone is used.
APP_TIMEZONE=

# --- Registration / enrolment -----------------------------------------------------
# Face-registration portal (HTTPS). Phones need HTTPS to open the camera.
REGISTRATION_PORT=5050
REGISTRATION_TLS=1
DISABLE_REGISTRATION=0
# 1 = while NO ID/password exists for a role, anyone may register. Keep 0 in production.
ALLOW_OPEN_REGISTRATION=0
# Never enable in production: face recognition is replaced by random numbers.
FACE_DEMO_MODE=0

# --- Attendance behaviour ------------------------------------------------------------
# 0 = a timetable slot without a section records NO student attendance (safe default).
# 1 = legacy behaviour: every registered student counts for unsectioned slots.
ALLOW_UNSECTIONED_CLASSES=0
# Optional overrides of the policy (can also be edited on the Settings page):
# ATTENDANCE_START_MARGIN_MIN=5
# ATTENDANCE_END_MARGIN_MIN=5
# ATTENDANCE_HEARTBEAT_SEC=60

# --- Cameras --------------------------------------------------------------------------
# Allow "video file" camera sources (testing only).
CAMERA_ALLOW_FILE_SOURCES=0

# --- Logging ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
# LOG_DIR=logs
